#!/usr/bin/env ruby
# frozen_string_literal: true

require 'English'
require_relative '../lib/biome/ruby/version'
require_relative '../lib/biome/ruby/upstream'

Dir.chdir(File.expand_path('..', __dir__))

version = Biome::Ruby::VERSION
packages = ["biome-ruby-#{version}.gem"]
packages += Biome::Ruby::Upstream::NATIVE_PLATFORMS.keys.map { |platform| "biome-ruby-#{version}-#{platform}.gem" }

packages.each do |package|
  path = "pkg/#{package}"
  loop do
    puts "gem push #{path}"
    break if system('gem', 'push', path)

    status = $CHILD_STATUS&.exitstatus || 1
    print "Push of #{package} failed. Retry? [Y/n] "
    answer = $stdin.gets
    exit(status) if answer.nil? || answer.strip.downcase.start_with?('n')
  end
end
